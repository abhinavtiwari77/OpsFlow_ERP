# PostgreSQL connection string
# Example for local: postgresql://postgres:postgres@localhost:5432/mini_erp?schema=public
# Example for Neon/Supabase/Render: use the connection string they give you
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_erp?schema=public"

# Secret used to sign JWTs - change this in production
JWT_SECRET="replace-this-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

PORT=4000
NODE_ENV=development

# Comma separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"
